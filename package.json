{
  "name": "dsh-quick-screenshot",
  "version": "1.0.0",
  "description": "One-click DSH screenshot: capture the DeepSeek Harness window (or the whole screen) from the Host and drop the PNG straight into the composer draft",
  "license": "MIT",
  "author": "JackEngineer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackEngineer/dsh-quick-screenshot.git"
  },
  "homepage": "https://github.com/JackEngineer/dsh-quick-screenshot#readme",
  "bugs": {
    "url": "https://github.com/JackEngineer/dsh-quick-screenshot/issues"
  },
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "screenshots.json",
    "README.md",
    "PUBLISHING.md"
  ],
  "scripts": {
    "test": "node scripts/selftest.mjs && node scripts/client-smoke.mjs",
    "test:host": "node scripts/selftest.mjs",
    "test:client": "node scripts/client-smoke.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "screenshot",
    "capture",
    "composer"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-attachment"
      ]
    }
  }
}
